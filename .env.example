# Any OpenAI-compatible chat completions endpoint works.
API_KEY=sk-...
BASE_URL=https://api.openai.com/v1
MODEL=gpt-5.4-mini

# auto  = read runs freely, write/edit/bash ask first (default)
# allow = never ask (only use in a sandbox)
# block = deny every tool call
APPROVAL_MODE=auto

# Safety valve: max model calls per user message
MAX_STEPS=25
